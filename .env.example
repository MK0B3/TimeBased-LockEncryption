# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost

# Drand Configuration
#
# This is the drand "quicknet" chain: unchained, 3-second rounds, signatures in G1.
# Timelock encryption requires an UNCHAINED chain, because the round's signature must
# be predictable as an identity before it exists. Do not point this at the original
# League of Entropy chain (8990e7a9...) -- it is chained and tlock will reject it.
DRAND_CHAIN_HASH=52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971
DRAND_URLS=https://api.drand.sh,https://drand.cloudflare.com

# Database (BoltDB file)
DB_PATH=./data/capsules.db

# Decryption Service
DECRYPT_CHECK_INTERVAL=30s
